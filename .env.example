# Скопируйте в .env (make setup делает это сам). .env — в .gitignore; секреты только здесь.

# Минуты без движения до перехвата чужой задачи (scripts/issues.sh take).
# 45 — хакатон до 2 дней; 120 — длинный хакатон.
TAKEOVER_MIN=45

# Предел размера файла вне Git LFS, МБ (.claude/hooks/check-data-files.sh).
MAX_FILE_MB=5

# Репозиторий шаблона для /retro: owner/hackathon-template
TEMPLATE_REPO=

# Файл сессий чата (SQLite). Пусто — data/sessions.db в корне репозитория.
SESSIONS_DB=

# LLM через OpenAI-совместимое API (POST <LLM_BASE_URL>/chat/completions).
# Модель включается, только если заданы адрес, модель и ключ: LLM_API_KEY или GIGACHAT_AUTH_KEY.
# Оба ключа пусты — агент работает по правилам («упрощённый режим без ИИ»), путь до брони тот же.
# Адрес и модель ниже — GigaChat. Другой провайдер: свои адрес, модель и LLM_API_KEY.
LLM_BASE_URL=https://api.giga.chat/v1
LLM_MODEL=GigaChat-3-Lightning
# Статичный ключ (Bearer). Задан — GIGACHAT_AUTH_KEY не используется.
# Ключ уходит на LLM_BASE_URL, а там уже адрес GigaChat. Другой провайдер — смените и
# LLM_BASE_URL, и LLM_MODEL.
LLM_API_KEY=
# GigaChat: ключ авторизации из личного кабинета developers.sber.ru (строка для Basic).
# Агент сам меняет его на токен доступа (живёт 30 минут) и обновляет токен.
# Сертификат НУЦ Минцифры для HTTPS лежит в backend/certs/, ставить его в систему не нужно.
GIGACHAT_AUTH_KEY=
# Область доступа: GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B или GIGACHAT_API_CORP — юрлица.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Адрес выдачи токена. Пусто — https://ngw.devices.sberbank.ru:9443/api/v2/oauth.
GIGACHAT_OAUTH_URL=
# Ожидание ответа модели, секунды. Таймаут, 401/403, 429, 5xx, неверный JSON — ответ по правилам.
LLM_TIMEOUT_S=8

# Уровень логов бэкенда: DEBUG, INFO, WARNING, ERROR. Пусто или неизвестное значение — INFO.
# В каждой записи есть session=<id сессии>. Трейс сбоя источника данных пишется только на DEBUG.
LOG_LEVEL=INFO
